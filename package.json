{
	"private": true,
	"description": "Linkwarden-based container for self-hosted collaborative bookmark management",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"compile:check": "tsc -noEmit -p ./tsconfig.json",
		"lint": "oxlint && markdownlint-cli2",
		"lint:fix": "oxlint --fix && markdownlint-cli2 --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"postinstall": "is-ci || lefthook install"
	},
	"devDependencies": {
		"@ac-kit/cmd-docker": "0.2.0",
		"@ac-kit/core": "0.2.0",
		"@ac-kit/format-shell": "0.1.0",
		"@ac-kit/integration-test-util": "0.2.0",
		"@ac-kit/markdownlint-cli2-config": "0.2.0",
		"@ac-kit/net-http": "0.1.1",
		"@ac-kit/oxlint-config": "0.2.0",
		"@ac-kit/tsconfig": "0.1.0",
		"@ac-kit/vitest-config": "0.1.1",
		"@types/node": "24.13.3",
		"is-ci": "4.1.0",
		"lefthook": "2.1.12",
		"markdownlint-cli2": "0.23.2",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "7.0.2001",
		"testcontainers": "12.1.0",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	}
}
