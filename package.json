{
	"private": true,
	"description": "Linkwarden-based container for self-hosted collaborative bookmark management",
	"author": "Anthony Champagne <dev@anthonychampagne.fr>",
	"scripts": {
		"test": "vitest run",
		"tsc:check": "tsc -noEmit -p ./tsconfig.json",
		"biome:check": "biome check --error-on-warnings",
		"biome:fix": "biome check --write",
		"biome:fix-unsafe": "biome check --write --unsafe",
		"markdownlint:check": "markdownlint-cli2",
		"markdownlint:fix": "markdownlint-cli2 --fix",
		"postinstall": "is-ci || lefthook install"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@biomejs/biome": "2.5.7",
		"tsx": "4.23.11",
		"typescript": "7.0.2",
		"lefthook": "2.1.10",
		"markdownlint-cli2": "0.23.2",
		"is-ci": "4.1.0",
		"@ac-essentials/tsconfig": "0.5.2",
		"@ac-essentials/cli": "0.1.5",
		"@ac-essentials/misc-util": "0.7.0",
		"@ac-essentials/biome-config": "0.5.0",
		"@ac-essentials/markdownlint-cli2-config": "0.1.0",
		"vitest": "4.1.10",
		"testcontainers": "12.1.0"
	}
}
